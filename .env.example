# Copy this file to .env.local for development, and set the same values
# in Vercel: Project → Settings → Environment Variables for production.
# Never commit the real .env.local file.

# --- WhatsApp Cloud API (business lead notifications) ---
# From Meta Business Platform → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The business/sales team's WhatsApp number that should receive new-lead alerts
WHATSAPP_NOTIFY_TO=918943200063

# --- Analytics (optional, add once accounts exist) ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# --- Database (required before production launch — see README) ---
# Example if using Vercel Postgres / Neon:
DATABASE_URL=
